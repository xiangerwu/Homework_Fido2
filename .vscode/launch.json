{
    // 使用 IntelliSense 以得知可用的屬性。
    // 暫留以檢視現有屬性的描述。
    // 如需詳細資訊，請瀏覽: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "PYTHONPATH": "${workspaceFolder}\\python\\fido-env\\Script\\python.exe",
                "FLASK_APP": "python\\app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--cert=adhoc",
                // "--no-debugger",
                // "--no-reload"
            ],
            "jinja": true,
            
        }
    ]
}